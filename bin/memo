#!/usr/bin/env bash
# Markdown → PDF helper
#
#   * Default: Pandoc → PDF.
#   * If glossaries / nomenclature requested **or** --tex given:
#       Pandoc → TeX → XeLaTeX (3‑pass) with optional glossaries / nomenclature.
#
# Requirements:
#   - npm i -g mermaid-filter
#   - TeX Live with xelatex, makeglossaries, makeindex
# -----------------------------------------------------------------------------
set -euo pipefail

###############################################################################
# 1 – Defaults & utilities
###############################################################################
INFO=0          # verbose mode enabled with --info
FORCE_TEX=0     # force TeX intermediate with --tex
GLOSSARY=0      # enabled with --glossary
NOMENCL=0       # enabled with --nomenclature
OPEN_PDF=0      # enabled with --open
YOINK_PDF=0     # enabled with --yoink  (macOS convenience)
KEEP=0          # leave intermediates with --keep
CLEAN_ONLY=0    # purge intermediates then exit with --clean
DOCTOR=0        # check toolchain then exit with --doctor
LOG_FILE=""
PREPROCESSED_MD=""

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] file.md [single|double]

Options:
  --info          Verbose logging to <file>_processing.log instead of /dev/null.
  --tex           Force TeX intermediate even if no glossary/nomenclature.

  --glossary      Build LaTeX glossaries (makeglossaries + two extra XeLaTeX runs).
  --nomenclature  Build LaTeX nomenclature (makeindex  + two extra XeLaTeX runs).

  --open          Automatically open the generated PDF (macOS, or Linux with xdg-open/open).
  --yoink         Send the generated PDF to Yoink (macOS only).

  --keep          Keep all temporary / intermediate files (no cleanup at exit).
  --clean         Delete temporary / intermediate files and exit without building.
  --doctor        Check that every required tool, template, filter, package and
                  font is installed, then exit.
  --template PATH Path to the root pandoc template name (defaults to 'custom_eisvogel' for single, 'custom_magazine' for double).

  -DNAME=VALUE    m4 define passed through to preprocessing (repeatable).
EOF
  exit 1
}

init_git_info() {
  BRANCH=unknown REVISION=unknown TAG=unknown
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    if git rev-parse HEAD &>/dev/null; then
      BRANCH=$(git rev-parse --abbrev-ref HEAD)
      REVISION=$(git rev-parse --short=7 HEAD)
      [[ -n $(git status --porcelain) ]] && REVISION+="*"
      TAG=$(git describe --tags --long 2>/dev/null || git rev-parse --short HEAD)
    else
      BRANCH=empty REVISION=empty TAG=
    fi
  fi
}

parse_layout() {
  case ${1:-single} in
    single) LAYOUT_OPT="";;
    # twocolumn metadata flag activates filters/twocolumn-tables.lua
    # (longtable cannot render in twocolumn mode)
    double) LAYOUT_OPT="--variable classoption=twocolumn --metadata=twocolumn:true";;
    *) echo "Layout must be 'single' or 'double'." ; exit 1;;
  esac
}

# Generic helper: run a command with its output captured in $LOG_FILE, also
# echoed to the terminal with --info. The log feeds log_errors/log_warnings
# and is removed on a clean run unless --info or --keep.
quiet_or_log() {   # quiet_or_log cmd arg …
  if (( INFO )); then "$@" 2>&1 | tee -a "$LOG_FILE"; else "$@" >>"$LOG_FILE" 2>&1; fi
}

# TeX compilation wrapper that ignores xelatex exit code but checks PDF output
run_xelatex() {    # run_xelatex file.tex
  local tex=$1
  quiet_or_log xelatex -interaction=nonstopmode "$tex" || true
  # Verify PDF was actually created
  [[ -f ${tex%.tex}.pdf ]] || { echo "XeLaTeX failed to produce PDF." ; exit 1; }
}

# Pull the lines that matter out of the pandoc/xelatex log. LaTeX reports
# errors as "! …" followed by an "l.NNN" line pointing into the intermediate
# .tex, pandoc prefixes its own with "pandoc:" or "Error producing PDF".
log_errors() {
  [[ -s $LOG_FILE ]] || return 0
  # grep exits 1 on no match; under set -e/pipefail that would abort the summary
  grep -E -A2 '^! ' "$LOG_FILE" | grep -v -- '^--$' | head -24 || true
  grep -E '^pandoc: |^Error producing PDF|^\[ERROR\]|^\[WARNING\] Could not' "$LOG_FILE" | head -5 || true
  [[ -s mermaid-filter.err ]] && { echo "mermaid-filter:"; head -10 mermaid-filter.err; }
  return 0
}

# Warnings worth a glance after a successful build: pandoc's own (missing
# citations, unknown filters), glyphs the font lacks, and overfull boxes.
log_warnings() {
  [[ -s $LOG_FILE ]] || return 0
  # pandoc echoes LaTeX's "Missing character" as a [WARNING] too; report it once
  grep -E '^\[WARNING\]' "$LOG_FILE" | grep -v 'Missing character' | sort -u | head -10 || true
  grep -oE 'Missing character: There is no [^ ]+ \([^)]*\) in font [^:]+' "$LOG_FILE" | sort -u | head -5 || true
  local n worst
  n=$(grep -c 'Overfull \\hbox' "$LOG_FILE" || true)
  if (( n )); then
    worst=$(grep -oE 'Overfull \\hbox \([0-9.]+pt' "$LOG_FILE" | grep -oE '[0-9.]+pt' | sort -rn | head -1 || true)
    echo "memo: $n overfull hbox(es), worst $worst too wide"
  fi
  return 0
}

# --doctor: report what the toolchain has and lacks, exit 1 if a required
# piece is missing. Optional entries only matter for the flag or layout named.
doctor() {
  local rc=0 level label hint
  check() {   # check req|opt LABEL HINT CMD…
    level=$1 label=$2 hint=$3; shift 3
    if "$@" >/dev/null 2>&1; then printf '  ok        %s\n' "$label"
    elif [[ $level == req ]]; then printf '  MISSING   %s  → %s\n' "$label" "$hint"; rc=1
    else printf '  optional  %s  → %s\n' "$label" "$hint"
    fi
  }
  echo "memo doctor"
  echo "  pandoc data dir: $PANDOC_DATA_DIR"
  echo "Commands"
  check req pandoc        'https://pandoc.org'                     command -v pandoc
  check req xelatex       'install TeX Live'                       command -v xelatex
  check req kpsewhich     'install TeX Live'                       command -v kpsewhich
  check req m4            'install m4 (gm4 on macOS via brew)'     command -v m4
  check req mermaid-filter 'npm i -g mermaid-filter'               command -v mermaid-filter
  check opt makeglossaries '--glossary needs it (TeX Live)'        command -v makeglossaries
  check opt makeindex     '--nomenclature needs it (TeX Live)'     command -v makeindex
  check opt pandoc-latex-environment 'pipx install pandoc-latex-environment' command -v pandoc-latex-environment
  check opt 'open / xdg-open' '--open needs one of them'           bash -c 'command -v open || command -v xdg-open'
  echo "Templates ($PANDOC_TPL_DIR)"
  check req custom_eisvogel.latex 'copy the Eisvogel template here' test -f "$PANDOC_TPL_DIR/custom_eisvogel.latex"
  check opt custom_magazine.latex 'needed for the double layout'  test -f "$PANDOC_TPL_DIR/custom_magazine.latex"
  check req ieee-with-url.csl 'citation-style-language/styles on GitHub' test -f "$PANDOC_TPL_DIR/ieee-with-url.csl"
  echo "Filters ($PANDOC_DATA_DIR/filters)"
  local f
  for f in "$BASE_PATH"/filters/*.lua; do
    f=$(basename "$f")
    check opt "$f" "copy from $BASE_PATH/filters" test -f "$PANDOC_DATA_DIR/filters/$f"
  done
  echo "LaTeX packages"
  local pkg
  for pkg in scrartcl.cls fontspec.sty booktabs.sty caption.sty enumitem.sty \
             mdframed.sty multicol.sty glossaries.sty nomencl.sty; do
    check req "$pkg" 'tlmgr install <package>' kpsewhich "$pkg"
  done
  echo "Fonts"
  check opt 'TeX Gyre Pagella' 'double layout body font (tlmgr install tex-gyre)' kpsewhich texgyrepagella-regular.otf
  return $rc
}

cleanup() {
  local rc=$?
  # A failed run leaves the log behind and summarizes it; a clean run
  # removes it unless --info or --keep asked for it.
  if (( rc )) && [[ -s ${LOG_FILE:-} ]]; then
    log_errors
    echo "memo: build failed, full log in $LOG_FILE" >&2
  elif ! (( INFO || KEEP )); then
    rm -f "${LOG_FILE:-}"
  fi
  if (( KEEP )); then
    (( INFO )) && echo "Keeping intermediates (--keep), skipping cleanup." \
              | tee -a "$LOG_FILE"
    return "$rc"
  fi

  # A failure before the file paths are resolved (usage error, missing
  # input) reaches this EXIT trap with BASENAME unset; there is nothing
  # to clean, and touching the variables under `set -u` would turn the
  # real error into "unbound variable" noise.
  [[ -n ${BASENAME:-} ]] || return 0

  (( INFO )) && echo "Cleaning up…" | tee -a "$LOG_FILE"
  [[ -f $PREPROCESSED_MD ]] && rm -f "$PREPROCESSED_MD"

  # LaTeX intermediate files
  if (( GLOSSARY || NOMENCL || FORCE_TEX )); then
    rm -f "${BASENAME}.tex" "${BASENAME}.aux" "${BASENAME}.log" \
          "${BASENAME}.out" "${BASENAME}.glo" "${BASENAME}.gls" \
          "${BASENAME}.glg" "${BASENAME}.ist" "${BASENAME}.xdy" \
          "${BASENAME}.ilg" "${BASENAME}.ild" "${BASENAME}.nlo" \
          "${BASENAME}.ind" "${BASENAME}.nls" "${BASENAME}.glsdefs" \
          "${BASENAME}.toc"
  fi
  rm -fr mermaid-img mermaid-filter.err
}

trap cleanup EXIT

error_handler() {
  (( INFO )) && echo "memo: error at script line $1" >&2
  exit 1
}
trap 'error_handler $LINENO' ERR

###############################################################################
# 2 – Argument parsing
###############################################################################
(( $# < 1 )) && usage

M4_PARAMS=()
while (( $# > 0 )); do
  case $1 in
    -D*)            M4_PARAMS+=("$1") ; shift ;;
    --info)         INFO=1            ; shift ;;
    --tex)          FORCE_TEX=1       ; shift ;;
    --glossary)     GLOSSARY=1        ; shift ;;
    --nomenclature) NOMENCL=1         ; shift ;;
    --open)         OPEN_PDF=1        ; shift ;;
    --yoink)        YOINK_PDF=1       ; shift ;;
    --keep)         KEEP=1            ; shift ;;
    --clean)        CLEAN_ONLY=1      ; shift ;;
    --doctor)       DOCTOR=1          ; shift ;;
    --template)
      [[ $# -ge 2 ]] || { echo "--template requires a value." ; exit 1; }
      TEMPLATE_NAME="$2"
      shift 2
      ;;
    --) shift; break ;;
    -*) usage ;;
    *)  break ;;
  esac
done

BASE_PATH=$(dirname "$(readlink -f "$0")")/..
DEFAULT_DATA_DIR=$(pandoc --version  | sed -E -n 's/^User data directory:[[:space:]]*(.*[^[:space:]])[[:space:]]*$/\1/p')
PANDOC_DATA_DIR="${PANDOC_DATA_DIR:-$DEFAULT_DATA_DIR}"
PANDOC_TPL_DIR="$PANDOC_DATA_DIR/templates"

if (( DOCTOR )); then doctor; exit $?; fi

MD=${1:-}; [[ -z $MD ]] && usage ; shift || true
if [[ ! -f $MD ]]; then
  echo "memo: no such file: $MD" >&2
  exit 2
fi
layout=${1:-single}
parse_layout "$layout"

###############################################################################
# 3 – Metadata & paths
###############################################################################
TS=$(date "+%Y-%m-%d %H:%M") ; D=${TS% *} ; T=${TS#* }
init_git_info

ABS_MD=$(realpath "$MD")
DIR=$(dirname "$ABS_MD")
BASENAME=$(basename "$ABS_MD" .md)
cd "$DIR" || { echo "Cannot cd into $DIR" ; exit 1; }

PDF="${BASENAME}.pdf"
BIB="${BASENAME}.bib"
PREPROCESSED_MD="${BASENAME}_preprocessed.md"
LOG_FILE="${BASENAME}_processing.log"
: >"$LOG_FILE"

export TEXINPUTS="$BASE_PATH:"

M4_PARAMS+=(
  "--include=$BASE_PATH"
  "-D__DATE__=$D" "-D__TIME__=$T" "-D__BRANCH__=$BRANCH"
  "-D__REVISION__=$REVISION" "-D__TAG__=$TAG" "-D__FILENAME__=$ABS_MD"
)


###############################################################################
# 4 – --clean (purge only) and early exit
###############################################################################
if (( CLEAN_ONLY )); then
  KEEP=0          # ensure files are actually removed
  cleanup
  echo "Temporary files removed."
  exit 0
fi

###############################################################################
# 4a – Pandoc filters (auto-detect optional filters)
###############################################################################
# Always keep mermaid; add pandoc-latex-environment if available (no breakage).
PANDOC_FILTERS=(-F mermaid-filter)
if command -v pandoc-latex-environment >/dev/null 2>&1; then
  PANDOC_FILTERS+=(-F pandoc-latex-environment)
fi

###############################################################################
# 5 – m4 pre‑processing
###############################################################################
{
  echo 'changequote(«, »)'
  echo 'changecom(«@@»)'
  cat "$ABS_MD"
} | m4 "${M4_PARAMS[@]}" - > "$PREPROCESSED_MD"
(( INFO )) && echo "Preprocessed → $PREPROCESSED_MD" | tee -a "$LOG_FILE"

###############################################################################
# 6 – Bibliography
###############################################################################
BIB_OPT="" ; [[ -f $BIB ]] && BIB_OPT="--bibliography=$BIB --citeproc"

###############################################################################
# 7 – Glossary / nomenclature (flags now control behaviour)
###############################################################################


###############################################################################
# 8 – Pandoc base args
###############################################################################

# Apply every Lua filter installed under the pandoc data dir, in name order
# (prefix with a number to control sequencing). No directory, no filters —
# existing installs behave exactly as before. This repo ships
# filters/table-widths.lua as the first such filter.
if [ -d "$PANDOC_DATA_DIR/filters" ]; then
  while IFS= read -r _lua; do
    PANDOC_FILTERS+=(--lua-filter "$_lua")
  done < <(find -H "$PANDOC_DATA_DIR/filters" -maxdepth 1 -name '*.lua' | sort)
fi
if [[ $layout == double ]]; then
  TEMPLATE_NAME="${TEMPLATE_NAME:-custom_magazine}"
else
  TEMPLATE_NAME="${TEMPLATE_NAME:-custom_eisvogel}"
fi
# Editorial transformations are opt-in through the magazine template only.
if [[ $(basename "$TEMPLATE_NAME" .latex) == custom_magazine ]]; then
  PANDOC_FILTERS+=(--metadata memo-magazine:true)
fi

# --syntax-highlighting is only understood by newer pandoc releases; older
# ones (<= 3.7) reject the whole invocation with "Unknown option". Fall back
# to --listings there so the script runs against either generation.
if pandoc --help 2>/dev/null | grep -q -- --syntax-highlighting; then
  HIGHLIGHT_OPT=(--syntax-highlighting=idiomatic)
else
  HIGHLIGHT_OPT=(--listings)
fi

pandoc_common=(
  --data-dir="$PANDOC_DATA_DIR"
  --verbose
  --pdf-engine=xelatex
  --from markdown
  --variable papersize=a4
  --template="$TEMPLATE_NAME"
  "${HIGHLIGHT_OPT[@]}"
  --csl="$PANDOC_TPL_DIR/ieee-with-url.csl"
  "${PANDOC_FILTERS[@]}"
  $LAYOUT_OPT
  $BIB_OPT
  -s "$PREPROCESSED_MD"
)

###############################################################################
# 9 – Build flow
###############################################################################

if (( GLOSSARY || NOMENCL || FORCE_TEX )); then
  # 9a – TeX intermediate path
  quiet_or_log pandoc "${pandoc_common[@]}" --extract-media=mermaid-img -o "${BASENAME}.tex"
  run_xelatex "${BASENAME}.tex"        # pass 1

  if (( GLOSSARY || NOMENCL )); then
    (( GLOSSARY )) && quiet_or_log makeglossaries -d . "$BASENAME"
    (( NOMENCL  )) && quiet_or_log makeindex "${BASENAME}.nlo" \
                                            -s nomencl.ist -o "${BASENAME}.nls"

    run_xelatex "${BASENAME}.tex"      # pass 2
    run_xelatex "${BASENAME}.tex"      # pass 3
  fi
else
  # 9b – Direct Pandoc → PDF
  quiet_or_log pandoc "${pandoc_common[@]}" -o "$PDF"
fi

###############################################################################
# 10 – Finish
###############################################################################
[[ -f $PDF ]] || { echo "PDF generation failed." ; exit 1; }
log_warnings

if (( INFO )); then
  {
    echo "========================================"
    echo "PDF saved → $PDF"
    echo "Completed at $(date)"
    echo "========================================"
  } | tee -a "$LOG_FILE"
fi

open_pdf() {
  local file="$1"
  if [[ $(uname) == Darwin ]]; then
    open "$file"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$file"
  elif command -v open >/dev/null 2>&1; then
    open "$file"
  elif (( INFO )); then
    echo "Cannot open PDF automatically: no 'open' or 'xdg-open' command found." >&2
  fi
}

# || : — an opener failure (headless box: xdg-open without a DISPLAY exits
# non-zero) must not fail a run whose PDF already built successfully; the
# pre-#7 macOS-only line carried the same guard for the same reason.
(( OPEN_PDF )) && open_pdf "$PDF" || :

# macOS convenience -----------------------------------------------------------
if [[ $(uname) == Darwin ]]; then
  (( YOINK_PDF )) && open -a yoink "$PDF" || :
fi
